{
  "name": "edge-results-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @edge-results/shared && npm run build --workspace @edge-results/api && npm run build --workspace @edge-results/worker && npm run build --workspace @edge-results/web",
    "typecheck": "npm run build --workspace @edge-results/shared && npm run typecheck --workspace @edge-results/api && npm run typecheck --workspace @edge-results/worker && npm run typecheck --workspace @edge-results/web && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.k6.json",
    "pretest": "npm run build --workspace @edge-results/shared",
    "test": "vitest run",
    "pretest:worker": "npm run build --workspace @edge-results/shared",
    "test:worker": "vitest run apps/worker/src",
    "test:watch": "vitest",
    "predev:api": "npm run build --workspace @edge-results/shared",
    "dev:api": "npm run dev --workspace @edge-results/api",
    "dev:web": "npm run dev --workspace @edge-results/web",
    "prestart:api": "npm run build",
    "start:api": "npm run start --workspace @edge-results/api",
    "worker:dev": "npm run dev --workspace @edge-results/worker",
    "worker:deploy": "npm run deploy --workspace @edge-results/worker",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "predb:migrate": "npm run build --workspace @edge-results/shared",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "predata:generate": "npm run build --workspace @edge-results/shared",
    "data:generate": "tsx --env-file-if-exists=.env scripts/generate-data.ts",
    "prekv:generate": "npm run build --workspace @edge-results/shared",
    "kv:generate": "tsx --env-file-if-exists=.env scripts/generate-kv-entries.ts",
    "worker:kv:local": "npm run kv:put:local --workspace @edge-results/worker",
    "worker:kv:remote": "npm run kv:put:remote --workspace @edge-results/worker",
    "k6:fixture": "tsx scripts/generate-k6-fixture.ts",
    "k6:inspect": "k6 inspect -e K6_TARGET=traditional -e K6_BASE_URL=http://127.0.0.1:3001 load-tests/smoke.ts",
    "k6:smoke": "k6 run load-tests/smoke.ts",
    "k6:load": "k6 run load-tests/load.ts",
    "k6:stress": "k6 run load-tests/stress.ts",
    "k6:spike": "k6 run load-tests/spike.ts",
    "k6:capacity": "k6 run load-tests/capacity.ts",
    "k6:edge:smoke": "tsx scripts/run-edge-benchmark.ts smoke",
    "k6:edge:load": "tsx scripts/run-edge-benchmark.ts load",
    "k6:edge:stress": "tsx scripts/run-edge-benchmark.ts stress",
    "k6:edge:spike": "tsx scripts/run-edge-benchmark.ts spike",
    "k6:edge:capacity": "tsx scripts/run-edge-benchmark.ts capacity",
    "benchmark:report": "tsx scripts/generate-benchmark-report.ts",
    "benchmark:capture:traditional": "tsx --env-file-if-exists=.env scripts/capture-traditional-metrics.ts",
    "ec2:provision": "tsx scripts/ec2-provision.ts provision",
    "ec2:status": "tsx scripts/ec2-provision.ts status",
    "ec2:connect": "tsx scripts/ec2-provision.ts connect",
    "ec2:destroy": "tsx scripts/ec2-provision.ts destroy",
    "predb:seed": "npm run build --workspace @edge-results/shared",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:prepare": "npm run db:migrate && npm run data:generate && npm run db:seed",
    "verify:phase1": "npm run typecheck && npm test && npm run build",
    "verify:phase2": "npm run typecheck && npm run test:worker && npm test && npm run build",
    "verify:phase3": "npm run verify:phase2 && npm run k6:fixture && npm run k6:inspect",
    "verify:phase4": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/k6": "^2.0.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
